{
    "manifest_version": 3,
    "name": "Gemini File Downloader",
    "version": "1.0",
    "description": "Downloads all files from a Gemini chat session as a zip archive.",
    "permissions": [
        "storage",
        "activeTab",
        "scripting"
    ],
    "host_permissions": [
        "https://gemini.google.com/app/*"
    ],
    "icons": {
        "16": "icons/icon16.svg",
        "48": "icons/icon48.svg",
        "128": "icons/icon128.svg"
    },
    "content_scripts": [
        {
            "matches": [
                "https://gemini.google.com/app/*"
            ],
            "js": [
                "external/jszip.min.js",
                "external/turndown.min.js",
                "content.js"
            ],
            "css": []
        }
    ]
}
